cff-version: 1.2.0
title: "marine-heatwave-replication"
message: "If you use this software, please cite it as below."
type: software
authors:
- family-names: "Fouilloux"
  given-names: "Anne"
  orcid: "https://orcid.org/0000-0002-1784-2920"
  affiliation: "LifeWatch ERIC"
repository-code: "https://github.com/annefou/marine-heatwave-replication"
license: MIT
version: "1.0.0"
date-released: "2026-08-15"
# Identifiers below are recorded AUTOMATICALLY on each release by
# .github/workflows/release-identifiers.yml — don't fill them in by hand.
#
# `doi:` is the CONCEPT DOI: it means "cite this project" and deliberately
# resolves to whatever version is latest. That floating behaviour is correct
# HERE and wrong in a nanopub — see scripts/set_release_identifiers.py.
#
# (This used to say "run /init-template again or edit by hand". /init-template
# deletes itself as its final step, so by the time a DOI existed the skill it
# named was gone and "edit by hand" was the only path left. Two repos built from
# this template then recorded the version DOI two different ways — one a
# structured identifier, one a prose comment. Hence the automation.)
doi: "10.5281/zenodo.21950032"
identifiers:
- type: doi
  value: 10.5281/zenodo.21950032
  description: Concept DOI (resolves to the latest version) — cite the project
- type: doi
  value: 10.5281/zenodo.21950033
  description: Version DOI for v1.0.0 — pins this exact release; cite this from nanopubs
- type: swh
  value: swh:1:rev:80f8e7d98a7e1d79904e347fd94de5e3d3ff04bd;origin=https://github.com/annefou/marine-heatwave-replication
  description: Software Heritage ID of the v1.0.0 source tree
keywords:
- replication
- reproducibility
- FORRT
- nanopublication
- Science-Live
references:
  # The paper under replication.
- type: article
  title: "Longer and more frequent marine heatwaves over the past century"
  authors:
  - family-names: "Oliver"
    given-names: "Eric C. J."
  year: "2018"
  doi: "10.1038/s41467-018-03732-9"

  # The INDEPENDENT detection engine. Author-disjoint from Oliver et al., which
  # is what makes this a Replication rather than a Reproduction — so pinning
  # exactly which XMHW produced these numbers is load-bearing, not bookkeeping.
  #
  # Identified by SWHID, not DOI, and deliberately: XMHW's Zenodo archive stops
  # at 0.9.2 (10.5281/zenodo.7662469), but this replication ran 1.0.0, which was
  # never deposited there. The concept DOI below cites the PROJECT; only the
  # SWHID identifies the REVISION whose output is reported here. Software
  # Heritage archived it independently of the authors, and the identifier is
  # forge-agnostic — it still resolves if the GitHub repository disappears.
  # Verified to resolve 2026-08-13; the same commit is pinned in pixi.toml.
- type: software
  title: "XMHW: Xarray based code to identify Marine HeatWave events and their characteristics"
  authors:
  - family-names: "Petrelli"
    given-names: "Paola"
  version: "1.0.0"
  repository-code: "https://github.com/coecms/xmhw"
  doi: "10.5281/zenodo.5112732"
  identifiers:
  - type: swh
    value: "swh:1:rev:1006312ae693e8aef8bd3706b9afb431eca564a5;origin=https://github.com/coecms/xmhw"
    description: "Software Heritage ID of the exact XMHW revision (tag 1.0.0) this replication ran"
  - type: doi
    value: "10.5281/zenodo.5112732"
    description: "Concept DOI for XMHW as a project — resolves to the latest DEPOSITED version (0.9.2), not the 1.0.0 used here"

  # The INDEPENDENT SST record. Different observational basis from the paper's
  # NOAA OISST / HadISST inputs, which is the other half of what makes this a
  # Replication.
- type: data
  title: "ESA SST CCI Analysis v3.0 (Level 4, global, daily)"
  year: "2024"
  doi: "10.5285/4a9654136a7148e39b7feb56f8bb02d2"
  notes: "Accessed via the Copernicus Marine Service ARCO store, dataset ID ESACCI-GLO-SST-L4-REP-OBS-SST"
