    {
      "@id": "notebooks/05_enso_removal.py",
      "@type": [
        "File",
        "SoftwareSourceCode"
      ],
      "name": "ENSO removal",
      "description": "Regresses daily SST anomalies onto the multivariate ENSO index with monthly leads and lags to +/-1 year and subtracts the fitted ENSO component, producing the input for the ENSO-removed series of the paper's Figure 2.",
      "encodingFormat": "text/x-python"
    },
    {
      "@id": "notebooks/06_sst_statistics.py",
      "@type": [
        "File",
        "SoftwareSourceCode"
      ],
      "name": "Annual SST moments",
      "description": "Annual mean, variance and skewness of sea surface temperature per cell; variance and skewness are computed on deseasonalised anomalies. Produces panels d-f of the paper's Figure 3.",
      "encodingFormat": "text/x-python"
    },
    {
      "@id": "notebooks/07_figure2.py",
      "@type": [
        "File",
        "SoftwareSourceCode"
      ],
      "name": "Figure 2 replica",
      "description": "Reproduces Oliver et al. (2018) Figure 2 in the published layout: globally averaged marine heatwave days with and without the ENSO signature, and El Nino / La Nina shading.",
      "encodingFormat": "text/x-python"
    },
    {
      "@id": "notebooks/08_figure3.py",
      "@type": [
        "File",
        "SoftwareSourceCode"
      ],
      "name": "Figure 3 replica",
